@{
    ViewData["Title"] = "درباره ما";
    ViewData["Canonical"] = ViewBag.Canonical;

    ViewData["Description"] = "ما در اپسیلون با سال‌ها تجربه در زمینه تأمین ورق‌های MDF با بالاترین استانداردها، آماده‌ایم تا نیازهای شما رو در پروژه‌های مسکونی، اداری و صنعتی برطرف کنیم. هدف ما ارائه محصولاتی با دوام، قیمت رقابتی و خدمات پس از فروش مطمئن است\r\n";
    @section Styles
    {
        <style>
            .mask {
                position: absolute;
                top: 0;
                right: 0;
                bottom: 0;
                left: 0;
                width: 100%;
                height: 100%;
                overflow: hidden;
                background-attachment: fixed;
            }

            .bg-image {
                position: relative;
                overflow: hidden;
                background-repeat: no-repeat;
                background-size: cover;
                background-position: center center;
            }
        </style>

    }
}
<!-- Hero -->
<div class="p-5 text-center bg-image rounded-3" style="
    background-image: url('/images/home/hero_bg_3.jpg');
    height: 50vh;
  ">
    <div class="mask" style="background-color: rgba(0, 0, 0, 0.6);">
        <div class="d-flex justify-content-center align-items-center h-100">
            <div class="text-white">
                <h1 class="display-5 fw-bold fs-2 text-white">@ViewData["Title"]</h1>

            </div>
        </div>
    </div>
</div>


<section>
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <div class="text-center">
                    <img src="/images/logo.jpg" class="my-2 rounded-circle" width="100" height="100" />
                    <p class="lead text-dark text-justify">
                        ما در اپسیلون با سال‌ها تجربه در زمینه تأمین ورق‌های MDF با بالاترین استانداردها، آماده‌ایم تا نیازهای شما رو در پروژه‌های مسکونی، اداری و صنعتی برطرف کنیم. هدف ما ارائه محصولاتی با دوام، قیمت رقابتی و خدمات پس از فروش مطمئن است


                    </p>
                </div>
            </div>
        </div>
    </div>
</section>
