
@using Microsoft.AspNetCore.Identity
@using Domain.Entities
@using Domain.Enums

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User) && (User.IsInRole(UserRoles.Role_Employee) || User.IsInRole(UserRoles.Role_Admin)))
{

    <a class="text-decoration-none  text-dark shadow rounded p-2 btn btn-primary" asp-area="Admin" asp-controller="Employee" asp-action="Index" title="ثبت محصول">
        <i class="bi bi-pencil-square"></i>
        اضافه کردن محصول

    </a>
}

